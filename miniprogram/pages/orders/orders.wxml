<view class="container">
  <view wx:if="{{!loggedIn}}" class="card center">
    <view class="tip">请先登录后查看订单</view>
    <view class="btn" bindtap="goProfile">去登录</view>
  </view>

  <view wx:elif="{{loading}}" class="tip">加载中...</view>
  <view wx:elif="{{orders.length === 0}}" class="tip">暂无订单</view>

  <view wx:for="{{orders}}" wx:key="id" class="order card">
    <view class="o-top">
      <text class="o-no">#{{item.id}}</text>
      <text class="o-status">{{item.status}}</text>
    </view>
    <view class="muted">麦当劳订单号：{{item.mcd_order_ref || '—'}}</view>
    <view class="muted">时间：{{fmt(item.created_at)}}</view>
  </view>
</view>

.store-bar {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 12rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.store-name { font-size: 30rpx; font-weight: 600; }
.store-change { color: #DA291C; font-size: 26rpx; }
.entry { margin: 24rpx 0 12rpx; }
.entry-btn { padding: 24rpx 0; font-size: 34rpx; }
.entry-grid { display: flex; margin: 12rpx 0 8rpx; }
.entry-cell {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  margin: 0 6rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 26rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.ec-ico { font-size: 44rpx; margin-bottom: 8rpx; }

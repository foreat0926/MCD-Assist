<view class="container">
  <view class="profile-card">
    <view class="avatar">👤</view>
    <view class="p-info">
      <view class="p-name">{{loggedIn ? '已登录' : '未登录'}}</view>
      <view class="muted" wx:if="{{loggedIn}}">openid：{{openid}}</view>
      <view class="muted" wx:else>登录后可下单/看订单</view>
    </view>
  </view>

  <view wx:if="{{!loggedIn}}" class="btn btn-red" bindtap="login">微信登录</view>
  <view wx:else class="btn btn-ghost" bindtap="logout">退出登录</view>

  <view class="section-title">我的服务</view>
  <view class="menu-list">
    <view class="m-cell" bindtap="goStores">
      <text>📍 选择门店</text>
      <text class="muted">{{storeName || '未选择'}} ›</text>
    </view>
    <view class="m-cell" bindtap="goOrders">
      <text>📄 我的订单</text>
      <text class="muted">›</text>
    </view>
    <view class="m-cell" bindtap="autoBind">
      <text>🎟️ 一键领取优惠券</text>
      <text class="muted">{{binding ? '领取中...' : '领取 ›'}}</text>
    </view>
  </view>
</view>

.search-bar { display: flex; flex-wrap: wrap; align-items: center; margin-bottom: 16rpx; }
.inp {
  flex: 1;
  min-width: 200rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin: 6rpx;
  font-size: 28rpx;
}
.search-btn { flex: 0 0 auto; margin: 6rpx; padding: 16rpx 36rpx; }
.store-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 12rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.s-top { display: flex; justify-content: space-between; align-items: center; }
.s-name { font-size: 30rpx; font-weight: 700; }
.s-status { font-size: 24rpx; padding: 2rpx 12rpx; border-radius: 8rpx; }
.s-status.open { color: #2ba24a; background: #e8f8ee; }
.s-status.closed { color: #999; background: #f0f0f0; }
.s-addr { font-size: 26rpx; color: #666; margin-top: 8rpx; }
.s-time { font-size: 24rpx; color: #999; margin-top: 4rpx; }

<view class="container">
  <view class="search-bar">
    <input class="inp" placeholder="城市，如 上海" value="{{city}}" bindinput="onCity" />
    <input class="inp" placeholder="关键词，如 麦当劳" value="{{keyword}}" bindinput="onKeyword" />
    <view class="btn search-btn" bindtap="search">搜索</view>
  </view>

  <view wx:if="{{loading}}" class="tip">搜索中...</view>
  <view wx:elif="{{searched && stores.length === 0}}" class="tip">未找到门店，换个词试试</view>

  <view wx:for="{{stores}}" wx:key="storeCode" class="store-card" bindtap="choose" data-idx="{{index}}">
    <view class="s-top">
      <text class="s-name">{{item.storeName}}</text>
      <text class="s-status {{item.businessStatus ? 'open' : 'closed'}}">{{item.businessStatus ? '营业中' : '已打烊'}}</text>
    </view>
    <view class="s-addr">{{item.address}} · 距 {{item.distance}}m</view>
    <view class="s-time">营业 {{item.businessStartTime}} - {{item.businessEndTime}}</view>
  </view>
</view>

.hero-card { text-align: center; }
.d-img { width: 100%; height: 360rpx; }
.d-name { font-size: 36rpx; font-weight: 700; margin-top: 12rpx; }
.comp { padding: 8rpx 0; }
.comp-name { font-size: 28rpx; font-weight: 600; }
.comp-choices { margin-left: 12rpx; font-size: 26rpx; }
.kcal { margin: 8rpx 0 20rpx; }
.kcal-num { font-size: 72rpx; font-weight: 800; color: #DA291C; }
.kcal-unit { font-size: 28rpx; color: #999; margin-left: 8rpx; }
.nutri-grid { display: flex; flex-wrap: wrap; }
.nutri {
  width: 33.33%;
  text-align: center;
  padding: 16rpx 0;
}
.n-v { display: block; font-size: 32rpx; font-weight: 700; }
.n-l { display: block; font-size: 22rpx; color: #999; margin-top: 4rpx; }

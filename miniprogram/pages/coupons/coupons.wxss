.coupon {
  width: 48%;
  margin: 1%;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.coupon image { width: 100%; height: 200rpx; background: #f3f3f3; }
.c-title {
  font-size: 26rpx;
  padding: 12rpx 16rpx 4rpx;
  height: 76rpx;
  overflow: hidden;
}
.c-status { font-size: 22rpx; color: #DA291C; padding: 0 16rpx 14rpx; }

<view class="container">
  <view wx:if="{{items.length === 0}}" class="empty">
    <view class="tip">购物袋是空的</view>
    <view class="btn" bindtap="goMenu">去菜单点餐</view>
  </view>

  <block wx:if="{{items.length > 0}}">
    <view class="cart-item" wx:for="{{items}}" wx:key="code">
      <image class="ci-img" src="{{item.image}}" mode="aspectFill" lazy-load="true" />
      <view class="ci-info">
        <view class="ci-name">{{item.name}}</view>
        <view class="muted">添加人：{{item.by || '我'}}</view>
        <view class="ci-row">
          <text class="price">¥{{item.price}}</text>
          <view class="qty">
            <text class="qty-btn" catchtap="dec" data-code="{{item.code}}">－</text>
            <text class="qty-num">{{item.quantity}}</text>
            <text class="qty-btn qty-inc" catchtap="inc" data-code="{{item.code}}">＋</text>
            <text class="ci-del" catchtap="remove" data-code="{{item.code}}">删除</text>
          </view>
        </view>
      </view>
    </view>

    <view class="btn btn-red optimize-btn" bindtap="optimize" disabled="{{optimizing}}">
      {{optimizing ? '计算中...' : '🎯 优惠结算'}}
    </view>
    <view wx:if="{{error}}" class="err">{{error}}</view>

    <!-- 主方案 -->
    <view wx:if="{{plan}}" class="plan">
      <view class="section-title">最优方案</view>
      <view class="card">
        <view class="plan-line"><text>合计</text><text class="price">¥{{plan.price}}</text></view>
        <view class="plan-line"><text>原价</text><text class="muted">¥{{plan.originalPrice}}</text></view>
        <view wx:if="{{plan.discount > 0}}" class="plan-line"><text>已优惠</text><text class="save">- ¥{{plan.discount}}</text></view>
        <view class="plan-line" wx:if="{{plan.coupon}}"><text>用券</text><text>{{plan.coupon.name || plan.coupon.couponId}}</text></view>
        <view class="plan-list">
          <view class="pl-item" wx:for="{{plan.productList}}" wx:key="productCode">
            {{item.productName}} ×{{item.quantity}} <text class="muted">¥{{item.subtotal}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 凑单参考 -->
    <view wx:if="{{reference}}" class="plan">
      <view class="section-title">凑单参考</view>
      <view class="card">
        <view class="muted">{{reference.note}}</view>
        <view class="plan-line"><text>加购后合计</text><text class="price">¥{{reference.price}}</text></view>
      </view>
    </view>

    <view class="btn btn-red checkout-btn" bindtap="checkout">去下单 ›</view>
  </block>
</view>

.pl-item { display: flex; justify-content: space-between; font-size: 28rpx; margin: 8rpx 0; }
.plan-line { display: flex; justify-content: space-between; font-size: 30rpx; margin-top: 12rpx; }
.total { border-top: 2rpx dashed #eee; padding-top: 12rpx; font-weight: 700; }
.save { color: #2ba24a; }
.notice {
  background: #fff7e0;
  color: #8a6d00;
  font-size: 26rpx;
  border-radius: 12rpx;
  padding: 16rpx;
  margin: 16rpx 0;
}
.ok { color: #2ba24a; }
.center { text-align: center; margin-top: 16rpx; }

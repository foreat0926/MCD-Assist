<view class="container">
  <view class="card">
    <view class="title">门店</view>
    <view class="muted">{{storeName}}</view>
  </view>

  <view class="section-title">订单明细</view>
  <view class="card">
    <view class="pl-item" wx:for="{{items}}" wx:key="code">
      <text>{{item.name}} ×{{item.quantity}}</text>
      <text class="muted">¥{{item.price}}</text>
    </view>
    <view class="plan-line total">
      <text>合计</text>
      <text class="price">¥{{plan ? plan.price : (items.length ? '待结算' : '0')}}</text>
    </view>
    <view wx:if="{{plan && plan.discount > 0}}" class="plan-line">
      <text>已优惠</text><text class="save">- ¥{{plan.discount}}</text>
    </view>
  </view>

  <view wx:if="{{!result}}" class="notice">下单将真实创建麦当劳订单，请确认无误。</view>

  <block wx:if="{{!result}}">
    <view class="btn btn-red" bindtap="submit" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '确认下单'}}
    </view>
    <view wx:if="{{!items.length}}" class="muted center">（无商品，请返回购物袋）</view>
  </block>

  <block wx:else>
    <view class="card">
      <view class="title ok">✅ 下单成功</view>
      <view class="muted">本地订单号：{{result.id}}</view>
      <view class="muted">麦当劳订单号：{{result.mcp && result.mcp.orderId}}</view>
    </view>
    <view class="btn btn-red" bindtap="viewOrders">查看我的订单</view>
  </block>
</view>

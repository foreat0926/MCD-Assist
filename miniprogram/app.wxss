/* 全局样式 */
page {
  background: #FFF8E1;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #333;
}
.container { padding: 24rpx; box-sizing: border-box; }
.hero {
  font-size: 56rpx;
  font-weight: 800;
  color: #DA291C;
  text-align: center;
  margin: 20rpx 0 8rpx;
}
.subtitle { text-align: center; color: #888; font-size: 26rpx; margin-bottom: 24rpx; }
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 24rpx 8rpx 12rpx;
  border-left: 8rpx solid #FFC72C;
  padding-left: 16rpx;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 12rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.title { font-size: 30rpx; font-weight: 600; }
.date { font-size: 24rpx; color: #999; margin-top: 6rpx; }
.summary { font-size: 26rpx; color: #666; margin-top: 8rpx; }
.tip { color: #999; font-size: 26rpx; padding: 16rpx 8rpx; }
.price { color: #DA291C; font-weight: 700; }
.muted { color: #999; font-size: 24rpx; }

/* 按钮 */
.btn {
  background: #FFC72C;
  color: #3a2a00;
  border-radius: 999rpx;
  text-align: center;
  padding: 18rpx 0;
  font-weight: 700;
  font-size: 30rpx;
}
.btn-red { background: #DA291C; color: #fff; }
.btn-ghost { background: #fff; color: #DA291C; border: 2rpx solid #DA291C; }
.btn[disabled] { opacity: 0.5; }

/* 商品网格 */
.grid { display: flex; flex-wrap: wrap; }
.grid-item {
  width: 48%;
  margin: 1%;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.grid-item image { width: 100%; height: 240rpx; background: #f3f3f3; }
.grid-item .info { padding: 12rpx 16rpx 16rpx; }
.grid-item .name { font-size: 26rpx; height: 72rpx; overflow: hidden; }
.grid-item .row { display: flex; justify-content: space-between; align-items: center; margin-top: 8rpx; }
.add-btn {
  background: #DA291C;
  color: #fff;
  border-radius: 50%;
  width: 48rpx; height: 48rpx;
  line-height: 48rpx; text-align: center; font-size: 36rpx;
}

# ===== 服务 =====
PORT=3000

# ===== 微信小程序登录 =====
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret

# ===== mcd-mcp（远程 Streamable HTTP 服务）=====
MCP_MCD_URL=https://mcp.mcd.cn
# 从本机 ~/.workbuddy/mcp.json 的 mcd-mcp.headers.Authorization 复制 Bearer 后的 token 填入
MCP_MCD_TOKEN=your_mcd_mcp_bearer_token

# ===== 数据库 =====
DB_PATH=./data/mcd-assist.db

# ===== 登录态签名 =====
JWT_SECRET=please_change_me
